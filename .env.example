# Configuration only; never put secrets in tracked files.
SEVENHEAVENS_DATA_DIR=./data
# Local-only execution. Cloud calls and weight downloads require explicit choice.
SEVENHEAVENS_MAX_UPLOAD_BYTES=2000000000
SEVENHEAVENS_DISK_RESERVE_BYTES=536870912
SEVENHEAVENS_PORT=8765
# Optional existing-only local vision paths; no automatic downloads.
# SEVENHEAVENS_MODEL_PATH=/absolute/path/to/existing/model-snapshot
# SEVENHEAVENS_MODEL_PYTHON=/absolute/path/to/.venv-vision/bin/python
